---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cases = (await getCollection('cases')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
---
<Base title="Mathilde Vita Blixenkrone-Møller" description="UX and frontend work.">
  <h1>Mathilde Vita Blixenkrone-Møller</h1>
  <p class="lede">
    I work with UX, from user research through to interaction design, and I
    write the code as well. Before that I spent six years as a sign language
    interpreter. What I like most is talking to the people who will use
    what I build, and letting what they say change it.
  </p>

  <ul class="cases">
    {cases.map((c) => (
      <li>
        <a href={`/work/${c.id}`}>
          <span class="year">{c.data.year}</span>
          <h2>{c.data.title}</h2>
          <p>{c.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
